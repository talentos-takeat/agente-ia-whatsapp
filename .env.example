# Modelo dos segredos. Os valores reais vão SOMENTE em
# Supabase > Edge Functions > Secrets (nunca neste arquivo, nunca no Git).

ANTHROPIC_API_KEY=
# Token da instância na uazapi (painel da uazapi)
UZAPI_TOKEN=
# Opcional: endereço do servidor da uazapi (padrão: https://automate-takeat.uazapi.com)
UAZAPI_URL=

# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente nas Edge Functions.
